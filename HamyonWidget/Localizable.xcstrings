    "Удерживайте ещё раз, чтобы снять фильтр": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold again to clear the filter"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrni olib tashlash uchun yana bosib turing"
          }
        }
      }
    },
    "Удерживайте перевод, чтобы отметить «Это перевод себе», — такие же переводы на ту же карту отметятся сами.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press a transfer to mark it as a transfer to yourself — transfers to the same card will be marked too."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bu o'zimga o'tkazma» deb belgilash uchun o'tkazmani bosib turing — o'sha kartaga shunday o'tkazmalar o'zi belgilanadi."
          }
        }
      }
    },
    "Уже вернули %@ из %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already repaid %@ of %@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Allaqachon qaytarildi: %@ / %@."
          }
        }
      }
    },
    "Уже есть — %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already added — %lld"
          }
        },
        "uz": {
