        }
      }
    },
    "SMS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS"
          }
        }
      }
    },
    "SMS банка": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank SMS"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank SMS'i"
          }
        }
      }
    },
    "iOS не даёт приложениям читать SMS напрямую — это делает автоматизация, и только для выбранного отправителя. Коды подтверждения и отказы ИИ пропускает, повторы не добавляются.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn’t let apps read SMS directly — the automation does it, and only for the sender you choose. The AI skips confirmation codes and declines, and duplicates aren’t added."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ilovalarga SMS'ni to'g'ridan-to'g'ri o'qishga ruxsat bermaydi — buni avtomatlashtirish bajaradi, faqat tanlangan jo'natuvchi uchun. SI tasdiqlash kodlari va rad etishlarni o'tkazib yuboradi, takrorlar qo'shilmaydi."
          }
        }
      }
    },
    "«Дал Азизу 500 тысяч до пятницы»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Lent Aziz 500k until Friday”"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Azizga juma kunigacha 500 ming qarz berdim»"
          }
        }
      }
    },
    "Анализ: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis: %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahlil: %@"
          }
        }
      }
    },
    "Анализирую расходы…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
