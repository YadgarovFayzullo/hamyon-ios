    "Включите «Запускать сразу» и нажмите «Далее».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Run Immediately” and tap “Next”."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Darhol ishga tushirish»ni yoqing va «Keyingi»ni bosing."
          }
        }
      }
    },
    "Возврат": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refund"
          }
        },
        "uz": {
