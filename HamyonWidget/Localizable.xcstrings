            "state": "translated",
            "value": "Tanlanmagan"
          }
        }
      }
    },
    "Не выбрана": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlanmagan"
          }
        }
      }
    },
