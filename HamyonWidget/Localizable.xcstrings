    "Сервис": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xizmat"
          }
        }
      }
    },
    "Скажите «обед 45 тысяч, такси 18» или подключите SMS банка — расходы будут добавляться сами.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “lunch 45 thousand, taxi 18” or connect your bank SMS — expenses will be added automatically."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Tushlik 45 ming, taksi 18» deng yoki bank SMS'ini ulang — xarajatlar o'zi qo'shilib boradi."
          }
        }
      }
    },
    "Сказать расход": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say an expense"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatni aytish"
          }
        }
      }
    },
    "Сколько и на что потратили?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much did you spend, and on what?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qancha va nimaga sarfladingiz?"
          }
        }
      }
    },
    "Сколько потрачено сегодня и за месяц.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much you spent today and this month."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun va oy davomida qancha sarflangani."
          }
        }
      }
    },
    "Сколько потрачено сегодня — в Dynamic Island и на экране блокировки. Обновляется с каждой новой SMS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s spending in the Dynamic Island and on the Lock Screen. Updates with every new SMS."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun qancha sarflangani — Dynamic Island va qulflangan ekranda. Har bir yangi SMS bilan yangilanadi."
          }
        }
      }
    },
    "Сколько сейчас наличных?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much cash do you have?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir qancha naqd pulingiz bor?"
          }
        }
      }
    },
    "Сколько ушло на такси в этом месяце?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much went on taxis this month?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy taksiga qancha ketdi?"
          }
        }
      }
    },
    "Скриншоты из «Фото»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots from Photos"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Rasmlar»dagi skrinshotlar"
          }
        }
      }
    },
    "Скрыть остатки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Balances"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoldiqlarni yashirish"
          }
        }
      }
    },
    "Скрыть суммы — только проценты": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide amounts — percentages only"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Summalarni yashirish — faqat foizlar"
          }
        }
      }
    },
    "Слишком много попыток. Подождите %lld с": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait %lld s"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Urinishlar juda ko'p. %lld soniya kuting"
          }
        }
      }
    },
    "Сменить код": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Passcode"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodni o'zgartirish"
          }
        }
      }
    },
    "Смотрю, на что ушла неделя…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking at where the week went…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta nimaga ketganini ko'ryapman…"
          }
        }
      }
    },
    "Снятие в банкомате пополняет кошелёк и больше не считается тратой. Тратой станут покупки за наличные — скажите «обед 45 тысяч наличными».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ATM withdrawals top up the wallet and no longer count as spending. Cash purchases do — say “lunch 45k in cash”."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankomatdan pul yechish hamyonni to'ldiradi va endi xarajat hisoblanmaydi. Naqd pulga xaridlar xarajat bo'ladi — «tushlik 45 ming naqd» deb ayting."
          }
        }
      }
    },
    "Снятие наличных": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash withdrawal"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Naqd pul yechish"
          }
        }
      }
    },
    "Со своей карты": {
