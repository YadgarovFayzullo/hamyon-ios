        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via"
          }
        }
      }
    },
    "Из выписки банка": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From bank statement"
          }
        }
      }
    },
    "Из SMS банка": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From bank SMS"
          }
        }
      }
    },
    "Сумму, дату, карту и поставщика из SMS изменить нельзя — это данные банка. Можно поменять категорию, указать, кому перевод, и добавить заметку.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount, date, card and merchant come from the bank and can't be changed. You can change the category, add who the transfer was for and add a note."
          }
        }
      }
    },
    "Кому": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To"
          }
        }
      }
    },
