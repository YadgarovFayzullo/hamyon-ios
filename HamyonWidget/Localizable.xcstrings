            "state": "translated",
            "value": "Turi"
          }
        }
      }
    },
    "Транспорт": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport"
          }
        }
      }
    },
    "Траты за сегодня": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's spending"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugungi xarajatlar"
          }
        }
      }
    },
    "У каждого впишите цены его позиций через «+»: «35 000 + 12 000». Общее делится поровну. Если по счёту выходит больше (обслуживание, чаевые), разница делится пропорционально заказу.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For each person enter their item prices with “+”: “35 000 + 12 000”. Shared items are split equally. If the bill is higher (service, tip), the difference is split in proportion to each order."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir kishiga uning taomlari narxini «+» orqali yozing: «35 000 + 12 000». Umumiy narsalar teng bo'linadi. Agar hisob ko'p chiqsa (xizmat haqi, choy pul), farq buyurtmaga mutanosib bo'linadi."
          }
        }
      }
    },
    "У кого взяли": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrowed from"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimdan olindi"
          }
        }
      }
    },
