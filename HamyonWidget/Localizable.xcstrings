      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not my card"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mening kartam emas"
          }
        }
      }
    },
    "Не нашёл сумму. Скажите, например: «кофе 25 тысяч».": {
      "localizations": {
        "en": {
