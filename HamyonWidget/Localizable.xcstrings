    },
    "Напоминание придёт в 10:00 за день до платежа.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder at 10:00 the day before."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eslatma to'lovdan bir kun oldin soat 10:00 da keladi."
          }
        }
      }
    },
    "Напоминания": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eslatmalar"
          }
        }
      }
    },
    "Напомнить накануне": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind the day before"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kun oldin eslatish"
          }
        }
      }
    },
    "Например, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E.g. %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Masalan, %@"
          }
        }
      }
    },
    "Например: «обед 45 тысяч, такси 18»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: “lunch 45 thousand, taxi 18”"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Masalan: «tushlik 45 ming, taksi 18»"
          }
        }
      }
    },
    "Настройки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalar"
          }
        }
      }
    },
    "Нашёл по операциям: та же сумма примерно в один день каждого месяца. Подтвердите — и накануне придёт напоминание.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found in your transactions: the same amount around the same day each month. Confirm to get a reminder the day before."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Amallaringizdan topdim: har oyning taxminan bir kunida bir xil summa. Tasdiqlang — bir kun oldin eslatma keladi."
          }
        }
      }
    },
    "Не выбран": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "uz": {
